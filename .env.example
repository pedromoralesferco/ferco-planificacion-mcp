# Puerto local del servicio MCP
PORT=3002
# API del app de Picking (red interna). El MCP solo llama /api/planificacion/* con el pase del usuario.
PLAN_API_URL=http://localhost:3001
# URL pública del app de Picking (el server.js del app reenvía /mcp y /.well-known/oauth-protected-resource* a este servicio).
# El conector en Claude es PLAN_PUBLIC_URL + /mcp. Sin barra final.
PLAN_PUBLIC_URL=https://picking-mcp.ferco.com.gt
# Authorization Server: Supabase Auth (el mismo login con Microsoft que usa Ventas Analytics)
PLAN_AUTH_SERVER=https://<proyecto>.supabase.co/auth/v1
# Orígenes permitidos (anti DNS-rebinding)
PLAN_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
